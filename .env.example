# =============================================================
# Bära — Root Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env files with real values to version control.
# =============================================================

# --- API Server (artifacts/api-server/.env) ---

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bara_db

# JWT secret for signing tokens — use a long random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars

# Reserved for a future dedicated refresh-token signing key. NOT currently
# read by the codebase — refresh tokens are random bytes stored in the
# refresh_tokens table, not JWTs. Kept here so the name is reserved.
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=

# AES-256-GCM key for encrypting personnummer/bank account fields at rest
# (GDPR — DAC7 KYC data). Must be at least 32 characters. REQUIRED in
# production — the server refuses to start without it.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Admin dashboard access key — shown at /api/admin
# REQUIRED in production and must be at least 32 characters — the server
# refuses to start otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
BARA_ADMIN_KEY=replace_with_random_hex_string

# Secondary stats endpoint key (legacy alias for BARA_ADMIN_KEY)
ADMIN_STATS_KEY=replace_with_random_hex_string

# Production URL of the deployed app (no trailing slash)
APP_BASE_URL=https://app.baraapp.se

# Comma-separated CORS origin allowlist. Falls back to the built-in
# baraapp.se / lovableproject.com allowlist if unset.
CORS_ORIGIN=

# Pino log level (trace|debug|info|warn|error|fatal). Defaults to "info".
LOG_LEVEL=info

# Optional webhook for critical alerts — reserved for future ops alerting,
# not currently wired to a specific integration.
ALERT_WEBHOOK_URL=

# --- Cloudinary (file/photo uploads) ---
# Get these from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Resend (transactional email) ---
# Get your API key from: https://resend.com/api-keys
# Without this set, the server runs in dev mode: new accounts are
# auto-verified (no OTP email flow) and no transactional emails are sent.
RESEND_API_KEY=re_your_resend_api_key
# Verified sender email address
RESEND_FROM_EMAIL=hello@yourdomain.se

# --- Maps (Mapbox — server-side geocoding for job pricing) ---
# Server-side secret token, never exposed to the client.
# REQUIRED in production — the server refuses to start without it.
# Create at https://account.mapbox.com/ → Tokens → Create a token (geocoding scope)
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret_token

# --- Push notifications ---
# Informational only — currently hardcoded in utils/push.ts, not read from
# the environment. Documented in case that changes.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# --- Feature flags ---
# Lead-gen (partner-routed) mode vs. open marketplace mode. Default true —
# set to "false" to restore the original driver-accepts-first marketplace.
LEAD_GEN_MODE=true

# --- Mobile App (artifacts/bara/.env) ---

# Domain where the API server is hosted (no https://, no trailing slash)
# Example: my-api.railway.app  or  api.baraapp.se
EXPO_PUBLIC_DOMAIN=your-railway-api-domain.railway.app

# Mapbox public token — client-side maps and geocoding fallback.
# Create at https://account.mapbox.com/ → Tokens
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Deprecated: superseded by EXPO_PUBLIC_MAPBOX_TOKEN (see
# "feat: migrate from Google Maps to Mapbox — 14x cost reduction"). Left here
# only because it may still be referenced by old client builds.
# Google Maps API key — enable Maps SDK + Places API in Google Cloud Console
# https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_MAPS_KEY=AIza_your_google_maps_api_key

# --- GitHub Actions Secrets (set in repo Settings > Secrets > Actions) ---
# These are only needed for CI/CD — do NOT put them in any .env file

# Railway API token for automatic deployment
# Get from: https://railway.app/account/tokens
# RAILWAY_TOKEN=your_railway_token  # → set as GitHub secret, not here
