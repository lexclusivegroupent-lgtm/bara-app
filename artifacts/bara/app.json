{
  "expo": {
    "name": "Bära",
    "slug": "bara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bara",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2A4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bara.app"
    },
    "android": {
      "package": "com.bara.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1B2A4A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png",
      "name": "Bära",
      "shortName": "Bära",
      "description": "Verified local companies for furniture transport, bulky item pickup, junk removal and second-hand deliveries in Sweden",
      "themeColor": "#1B2A4A",
      "backgroundColor": "#1B2A4A",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "sv"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://app.baraapp.se"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bära uses your location to find nearby addresses and service areas.",
          "locationWhenInUsePermission": "Bära uses your location to find nearby addresses and service areas."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "MAPBOX_SECRET_TOKEN_PLACEHOLDER"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
