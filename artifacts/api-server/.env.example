# =============================================================
# API Server — Environment Variables
# Copy to artifacts/api-server/.env for local development.
# NEVER commit .env files with real values to version control.
# =============================================================

# ─── Authentication ───────────────────────────────────────────
# Signs both access JWTs and the legacy 7-day tokens (middlewares/auth.ts).
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars

# Reserved for a future dedicated refresh-token signing key. NOT currently
# read by this codebase — refresh tokens are random bytes stored in the
# refresh_tokens table (see rotateRefreshToken in middlewares/auth.ts), not
# JWTs, so there is nothing to sign yet. Kept here so the name is reserved.
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=

# ─── Encryption (GDPR — personnummer + bank account) ──────────
# AES-256-GCM key for encrypting DAC7 KYC fields at rest (utils/crypto.ts).
# Must be at least 32 characters; only the first 32 are used.
# REQUIRED in production — the server refuses to start without it.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Admin access ─────────────────────────────────────────────
# Protects /api/admin/* (x-admin-key header). REQUIRED in production and
# must be at least 32 characters — the server refuses to start otherwise.
# Generate with: openssl rand -hex 32
BARA_ADMIN_KEY=replace_with_random_hex_string

# Legacy alias also accepted for BARA_ADMIN_KEY — set one or the other.
ADMIN_STATS_KEY=replace_with_random_hex_string

# ─── Email (Resend) ───────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Without this set, the server runs in dev mode: new accounts are
# auto-verified and no emails are sent (registration OTP, receipts, etc.)
RESEND_API_KEY=re_your_resend_api_key
# Verified sender identity
RESEND_FROM_EMAIL=Bära <noreply@baraapp.se>

# ─── Database ─────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bara_db

# ─── Push notifications ───────────────────────────────────────
# Informational only — the Expo push endpoint is currently hardcoded in
# utils/push.ts, not read from the environment. Documented here in case
# that changes (e.g. self-hosted push relay).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ─── Image upload (Cloudinary) ────────────────────────────────
# Get these from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Maps ─────────────────────────────────────────────────────
# Server-side geocoding for job pricing (routes/distance.ts) — never expose.
# Create at https://account.mapbox.com/ → Tokens → Create a token (geocoding scope)
# REQUIRED in production — the server refuses to start without it.
MAPBOX_SECRET_TOKEN=sk.eyJ1IjoieW91cl91c2VybmFtZSIsImEiOiJ5b3VyX3Rva2VuIn0.your_token_here
# Client-side public token, used as a geocoding fallback if the secret token
# is unset (routes/distance.ts) and by the Expo app's map screens.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# ─── Feature flags ────────────────────────────────────────────
# Lead-gen (partner-routed) mode vs. open marketplace mode. Default true —
# set to "false" to restore the original driver-accepts-first marketplace.
LEAD_GEN_MODE=true

# ─── Runtime ───────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# Restricts CORS to a comma-separated origin list (app.ts). Falls back to
# the built-in baraapp.se / lovableproject.com allowlist if unset.
CORS_ORIGIN=

# Public URL of the deployed app (no trailing slash) — used in email templates.
APP_BASE_URL=https://app.baraapp.se

# Pino log level (trace|debug|info|warn|error|fatal). Defaults to "info".
LOG_LEVEL=info

# Optional webhook for critical alerts (not currently wired to a specific
# integration — reserved for future ops alerting).
ALERT_WEBHOOK_URL=
