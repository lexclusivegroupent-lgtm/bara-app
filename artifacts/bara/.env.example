# =============================================================
# Bära Mobile App — Environment Variables
# Copy to artifacts/bara/.env for local development.
# All EXPO_PUBLIC_ variables are bundled into the client.
# =============================================================

# Full URL of the API server (preferred — takes precedence over EXPO_PUBLIC_DOMAIN)
# Local:      http://localhost:8080
# Production: https://api.baraapp.se
EXPO_PUBLIC_API_URL=http://localhost:8080

# Legacy: domain only (no scheme, no trailing slash). Used if EXPO_PUBLIC_API_URL is unset.
# EXPO_PUBLIC_DOMAIN=localhost:8080

# Mapbox public access token (starts with pk.)
# Create at https://account.mapbox.com/ → Tokens → Create a token
# Used for: map display, address geocoding, address autocomplete (client-side fallback)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91cl91c2VybmFtZSIsImEiOiJ5b3VyX3Rva2VuIn0.your_token_here
